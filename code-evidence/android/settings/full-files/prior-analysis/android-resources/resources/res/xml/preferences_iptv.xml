<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        android:icon="@null"
        android:entries="@array/iptv_list_update_mode_strings"
        android:title="@string/iptv_list_update_mode_pref_title"
        android:key="@string/pref_iptv_list_update_mode"
        android:summary="@string/iptv_list_update_mode_pref_summary"
        android:entryValues="@array/iptv_list_update_mode_values"
        android:singleLineTitle="false"
        android:iconSpaceReserved="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"/>
    <CheckBoxPreference
        android:icon="@null"
        android:title="@string/iptv_skip_standalone_groups_pref_title"
        android:key="@string/pref_iptv_skip_standalone_groups"
        android:summary="@string/iptv_skip_standalone_groups_pref_summary"
        android:defaultValue="true"
        android:singleLineTitle="false"
        android:iconSpaceReserved="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"/>
    <CheckBoxPreference
        android:icon="@null"
        android:title="@string/iptv_parse_show_info_pref_title"
        android:key="@string/pref_iptv_parse_show_info"
        android:summary="@string/iptv_parse_show_info_pref_summary"
        android:defaultValue="true"
        android:singleLineTitle="false"
        android:iconSpaceReserved="false"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"/>
    <Preference
        android:icon="@null"
        android:title="@string/setting_title_iptv_parser_m3u"
        android:key="@string/pref_screen_iptv_parser_m3u"
        android:summary="@string/setting_summary_iptv_parser_m3u"
        android:iconSpaceReserved="false"
        app:fragment="com.instantbits.cast.webvideo.settings.SettingsIPTVParserM3UFragment"
        app:iconSpaceReserved="false"/>
    <Preference
        android:icon="@null"
        android:title="@string/setting_title_iptv_parser_rss"
        android:key="@string/pref_screen_iptv_parser_rss"
        android:summary="@string/setting_summary_iptv_parser_rss"
        android:iconSpaceReserved="false"
        app:fragment="com.instantbits.cast.webvideo.settings.SettingsIPTVParserRSSFragment"
        app:iconSpaceReserved="false"/>
</PreferenceScreen>
